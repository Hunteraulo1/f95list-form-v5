# Database
DATABASE_URL=

# Zitadel
ZITADEL_DOMAIN=http://localhost:8080
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
# Rôles communs à tous les services : id du projet Zitadel qui les porte, et jeton (PAT) d'un compte
# de service aux rôles ORG_OWNER et IAM_LOGIN_CLIENT : il gère les rôles et leurs attributions, le compte
# de chacun depuis ses paramètres (pseudo, e-mail, mot de passe, double authentification), l'inscription,
# et l'écran de connexion quand le panel le tient (réglage « Login V2 » de Zitadel : <panel>/signin/).
# Laisser vide coupe la synchronisation : le rôle local fait foi.
ZITADEL_PROJECT_ID=
ZITADEL_SERVICE_TOKEN=
# Connexion par Discord : id du fournisseur d'identité « Discord » déclaré dans Zitadel. L'identifiant
# Discord des comptes vient alors de ce lien. Laisser vide : il se saisit à la main.
ZITADEL_DISCORD_IDP_ID=

# Redis
REDIS_URL=

# Scraper (f95list-form-v5-scraper) : pré-remplissage « Infos jeu » depuis F95zone.
# Laisser vide désactive simplement le pré-remplissage.
SCRAPER_URL=
SCRAPER_AUTH_TOKEN=

# Traduction automatique (LibreTranslate) de la description française, comme en v4.
# Laisser vide désactive simplement la traduction automatique.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Logs
LOG_LEVEL=info
