{
  "name": "f95list-form-v5",
  "private": false,
  "version": "5.0.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:up": "docker compose -f ./docker/dev/compose.yml up -d mariadb-dev",
    "dev:down": "docker compose -f ./docker/dev/compose.yml down",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run scripts/start.ts",
    "check": "svelte-kit sync && svelte-check --tsgo",
    "lint": "biome check .",
    "format": "biome format --write .",
    "sort-classes": "node scripts/sort-classes.mjs",
    "db:migration:create": "mikro-orm migration:create",
    "db:migration:up": "mikro-orm migration:up",
    "db:schema:update": "mikro-orm schema:update --run",
    "db:seed": "bun run src/lib/server/db/seed.ts",
    "db:migrate-v4": "bun run src/lib/server/db/migrate-v4.ts",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "10.6.0",
    "@mikro-orm/cli": "7.2.5",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "5.0.3",
    "clsx": "2.1.1",
    "commitizen": "4.3.2",
    "cz-emoji": "1.3.2-canary.2",
    "dotenv": "18.0.7",
    "dotenv-cli": "11.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lucide/svelte": "1.55.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/mariadb": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@tanstack/query-devtools": "5.104.1",
    "@tanstack/svelte-query": "6.3.1",
    "bits-ui": "2.19.5",
    "codemirror": "6.0.2",
    "marked": "18.1.0",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "svelte-codemirror-editor": "2.1.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "typescript": "~6"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    },
    "cz-emoji": {
      "scopes": [
        "backend",
        "frontend"
      ],
      "skipQuestions": [
        "body",
        "breaking",
        "issues"
      ]
    }
  },
  "lint-staged": {
    "*.svelte": [
      "biome check --write",
      "node scripts/sort-classes.mjs"
    ],
    "*.{js,ts}": [
      "biome check --write"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write"
    ]
  }
}
