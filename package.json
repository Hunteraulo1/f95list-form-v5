{
  "name": "f95list-form-v5",
  "private": false,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:up": "docker compose -f ./docker/dev/compose.yml up -d mariadb-dev",
    "dev:down": "docker compose -f ./docker/dev/compose.yml down",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run scripts/start.ts",
    "check": "svelte-kit sync && svelte-check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/lib/server/db/seed.ts",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@faker-js/faker": "10.5.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/browser": "4.1.10",
    "clsx": "2.1.1",
    "commitizen": "4.3.2",
    "cz-emoji": "1.3.2-canary.2",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "drizzle-seed": "0.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "valibot": "1.4.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tanstack/query-devtools": "5.101.4",
    "@tanstack/svelte-query": "6.1.38",
    "bits-ui": "2.18.1",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-svelte": "1.0.1",
    "mysql2": "3.23.2",
    "pino": "10.3.1",
    "ws": "^8.21.2"
  },
  "overrides": {
    "typescript": "~6",
    "drizzle-orm": "rc"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    },
    "cz-emoji": {
      "scopes": [
        "backend",
        "frontend"
      ],
      "skipQuestions": [
        "body",
        "breaking",
        "issues"
      ]
    }
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "biome check --write"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write"
    ]
  }
}
