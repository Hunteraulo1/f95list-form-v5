{
	"name": "f95list-form-v5",
	"private": false,
	"version": "5.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "bunx --bun @biomejs/biome check --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"commitizen": "4.3.2",
		"cz-emoji": "1.3.2-canary.2",
		"svelte": "5.56.6",
		"svelte-check": "4.7.3",
		"typescript": "7.0.2",
		"vite": "8.1.5"
	},
	"config": {
		"commitizen": {
			"path": "cz-emoji"
		},
		"cz-emoji": {
			"scopes": [
				"backend",
				"frontend"
			],
			"skipQuestions": [
				"body",
				"breaking"
			]
		}
	}
}
