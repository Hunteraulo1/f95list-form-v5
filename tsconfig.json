{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "node"],
    //? `#lib` est déjà résolu par les `imports` de package.json. Ce doublon ne sert qu'à
    //? `svelte-check --tsgo`, qui sans lui ne voit pas les types exportés par un composant `.svelte`.
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
